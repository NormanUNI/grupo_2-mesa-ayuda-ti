# Copiar a .env y completar. El archivo .env esta excluido por .gitignore
# y nunca entra al historial del repositorio.

# Proveedor: eco (local, sin red ni llave) o deepseek.
PROVEEDOR_MODELO=eco

# DeepSeek (formato compatible con OpenAI)
DEEPSEEK_API_KEY=
MODELO_DEEPSEEK=deepseek-flash
URL_DEEPSEEK=https://api.deepseek.com
